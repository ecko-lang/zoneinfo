# The calendar core, shared by main.ecko and zone.ecko. Internal to the
# package: main.ecko imports it without re-exporting it.
#
# Howard Hinnant's days<->civil algorithm in its floor-division form (Ecko's
# `//`), correct for every proleptic-Gregorian date before and after 1970.

# civil_from_days(z) -> [year, month, day]; z = days since 1970-01-01.
export fn civil_from_days(z0) {
    z = z0 + 719468
    era = z // 146097
    doe = z - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = if mp < 10 { mp + 3 } else { mp - 9 }
    yy = if m <= 2 { y + 1 } else { y }
    [yy, m, d]
}

# days_from_civil(y, m, d) -> days since 1970-01-01.
export fn days_from_civil(y0, m, d) {
    y = if m <= 2 { y0 - 1 } else { y0 }
    era = y // 400
    yoe = y - era * 400
    doy = (153 * if m > 2 { m - 3 } else { m + 9 } + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    era * 146097 + doe - 719468
}

## Whether `y` is a leap year, by the full Gregorian rule.
export fn is_leap(y) = y % 4 == 0 and y % 100 != 0 or y % 400 == 0

## How many days month `m` has in year `y`.
export fn days_in_month(y, m) {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}
