# zoneinfo - IANA time zones for Ecko.
#
# Reads a Unix-millisecond timestamp (UTC, the value std.time and the datetime
# package use) as the wall time in a named zone, and builds one from a wall
# time there. DST changes are handled from the IANA time zone database, which
# is compiled into tzdata.ecko, so the answer is the same on every machine and
# needs no system files. All pure; no capabilities.
#
#   import zoneinfo
#
#   z = zoneinfo.in_zone(now, "Europe/Berlin")    # { year, ..., hour, offset, abbreviation, ... }
#   cutoff = zoneinfo.from_components("America/New_York", 2026, 7, 16, 17)
#   zoneinfo.add_days(t, 1, "Europe/Berlin")      # same wall time tomorrow
#
# A zone never becomes part of a value. A timestamp stays a UTC instant, and a
# zone is a way to read one or to build one from a wall time. It is its own
# package, rather than part of datetime, so that a program which never names a
# zone does not pay to load the database.

import std.time
import "./calendar.ecko"
import "./zone.ecko" as tz

MS_DAY = 86400000
MS_HOUR = 3600000
MS_MIN = 60000
MS_SEC = 1000

# ---- the database ----------------------------------------------------------
## Every zone and alias name the database knows, sorted: "Africa/Abidjan"
## through "Zulu".
export fn zones() = tz.names()

## The IANA time zone database release the zones come from, such as "2026e".
export fn version() = tz.version()

# ---- reading an instant ----------------------------------------------------
## `zone`'s offset from UTC at instant `ms`, in milliseconds: positive east of
## Greenwich, so Berlin in summer is 7200000. Raises `{ kind: "parse", format:
## "zone" }` for a name the database does not know, as every function here does.
export fn offset(ms, zone) = tz.at(zone, ms // MS_SEC).off * MS_SEC

## The wall time instant `ms` shows in `zone`: `{ year, month, day, hour,
## minute, second, millisecond, weekday, yearday }` (the fields of
## `datetime.components`, weekday Mon=0..Sun=6), plus `offset` (ms),
## `abbreviation` ("CEST"), `dst` and `zone`. Any IANA name or alias works,
## such as "Europe/Berlin" or "US/Eastern".
##
## example:
##   in_zone(time.now(), "Asia/Tokyo").hour
export fn in_zone(ms, zone) {
    t = tz.at(zone, ms // MS_SEC)
    wall = ms + t.off * MS_SEC
    dnum = wall // MS_DAY
    tod = wall - dnum * MS_DAY
    ymd = calendar.civil_from_days(dnum)
    {
        year: ymd[0],
        month: ymd[1],
        day: ymd[2],
        hour: tod // MS_HOUR,
        minute: tod // MS_MIN % 60,
        second: tod // MS_SEC % 60,
        millisecond: tod % MS_SEC,
        weekday: (dnum + 3) % 7,
        yearday: dnum - calendar.days_from_civil(ymd[0], 1, 1) + 1,
        offset: t.off * MS_SEC,
        abbreviation: t.abbr,
        dst: t.dst,
        zone: zone,
    }
}

# ---- building an instant ---------------------------------------------------
## The instant a wall time in `zone` names, as Unix ms.
##
## A time a DST change skips moves forward by the length of the gap: 02:30 on a
## night that jumps from 02:00 to 03:00 is 03:30. A time it repeats is the
## first occurrence, the one still on the earlier offset.
##
## example:
##   from_components("America/New_York", 2026, 7, 16, 17)   # 17:00 in New York
export fn from_components(zone, y, mo, d, h = 0, mi = 0, s = 0, milli = 0) {
    wall = calendar.days_from_civil(y, mo, d) * MS_DAY +
        h * MS_HOUR +
        mi * MS_MIN +
        s * MS_SEC +
        milli
    from_wall(wall, zone)
}

# The instant a wall time (ms, read as if UTC) names in `zone`.
fn from_wall(wall, zone) = tz.to_utc(zone, wall // MS_SEC) * MS_SEC + wall % MS_SEC

# The wall time (ms, read as if UTC) an instant shows in `zone`.
fn local(ms, zone) = ms + offset(ms, zone)

# ---- arithmetic on the wall clock ------------------------------------------
## The instant `n` calendar days later in `zone`, at the same wall time. A day
## across a DST change is 23 or 25 hours long. `n` may be negative.
export fn add_days(ms, n, zone) = from_wall(local(ms, zone) + n * MS_DAY, zone)

## The instant `n` months later in `zone`, at the same wall time, clamping the
## day to the target month's length (Jan 31 + 1 month is Feb 28 or 29).
export fn add_months(ms, n, zone) {
    c = in_zone(ms, zone)
    total = c.year * 12 + (c.month - 1) + n
    y = total // 12
    mo = total % 12 + 1
    dim = calendar.days_in_month(y, mo)
    d = if c.day < dim { c.day } else { dim }
    from_components(zone, y, mo, d, c.hour, c.minute, c.second, c.millisecond)
}

## The instant `n` years later in `zone`, at the same wall time. 29 February
## plus one year is 28 February.
export fn add_years(ms, n, zone) = add_months(ms, n * 12, zone)

## Midnight in `zone` on the day instant `ms` falls on there. On a day a DST
## change skips midnight, the first moment of the day.
export fn start_of_day(ms, zone) = from_wall(local(ms, zone) // MS_DAY * MS_DAY, zone)

# ---- formatting and parsing ------------------------------------------------
## Format instant `ms` as the wall time in `zone`, with a strftime-style
## pattern. `%Z` writes the zone's abbreviation ("CEST"), `%z` its offset
## ("+0200") and `%:z` the offset with a colon ("+02:00").
##
## example:
##   format(time.now(), "%Y-%m-%d %H:%M %Z", "Europe/Berlin")
export fn format(ms, fmt, zone) {
    t = tz.at(zone, ms // MS_SEC)
    time.format(ms + t.off * MS_SEC, with_zone_fields(fmt, t))
}

# `fmt` with %z, %:z and %Z replaced by the zone's own values, which chrono
# would otherwise write for UTC. A `%%` stays an escaped percent sign.
fn with_zone_fields(fmt, t) {
    cs = chars(fmt)
    mut out = ""
    mut i = 0
    while i < len(cs) {
        if cs[i] == "%" and i + 1 < len(cs) {
            next = cs[i + 1]
            if next == "z" {
                out = out + offset_text(t.off, "")
                i = i + 2
            } else if next == "Z" {
                out = out + t.abbr
                i = i + 2
            } else if next == ":" and i + 2 < len(cs) and cs[i + 2] == "z" {
                out = out + offset_text(t.off, ":")
                i = i + 3
            } else {
                out = out + "%" + next
                i = i + 2
            }
        } else {
            out = out + cs[i]
            i = i + 1
        }
    }
    out
}

# "+0530" or "-02:30" from an offset in seconds.
fn offset_text(off, sep) {
    sign = if off < 0 { "-" } else { "+" }
    a = if off < 0 { 0 - off } else { off }
    h = a // 3600
    m = a // 60 % 60
    pad = fn(n) if n < 10 { "0{n}" } else { "{n}" }
    "{sign}{pad(h)}{sep}{pad(m)}"
}

## ISO-8601 for the wall time in `zone`, with its offset:
## `2026-07-29T15:45:00.000+02:00`. `time.parse` reads it back to the same
## instant.
export fn to_iso(ms, zone) = format(ms, "%Y-%m-%dT%H:%M:%S%.3f%:z", zone)

## Parse text `s` with a strftime-style pattern as a wall time in `zone`, read
## the way `from_components` reads one. A pattern with `%z` carries its own
## offset, so `zone` does not apply to it.
##
## example:
##   parse_format("29/07/2026 17:00", "%d/%m/%Y %H:%M", "America/New_York")
export fn parse_format(s, fmt, zone) {
    t = time.parse_format(s, fmt)
    if contains(fmt, "%z") or contains(fmt, "%:z") { return t }
    from_wall(t, zone)
}
