# zoneinfo: offsets, wall times and zone-aware arithmetic.
#
# The expected values come from Python's zoneinfo (an independent reader of
# the same IANA 2026e data), taken once and written in here so the tests stay
# offline and deterministic. They cover northern and southern DST, a 30-minute
# DST (Lord Howe), negative DST (Dublin), DST that ends at 24:00 (Santiago) or
# starts at -1:00 (Nuuk), a 45-minute offset (Chatham), Casablanca's
# Ramadan rule, and instants after 2037, where only the POSIX rule applies.
import std.test
import std.time
import "../main.ecko"
zi = main

HOUR = 3600000

# A UTC instant, for building test inputs.
fn utc(y, mo, d, h = 0) = zi.from_components("UTC", y, mo, d, h)

# [zone, unix seconds, offset seconds, abbreviation]
