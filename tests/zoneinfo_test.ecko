# [zone, year, month, day, hour, minute, unix seconds]: a wall time read in the
# zone. Includes a time a DST change skips (it moves forward by the gap) and
# one it repeats (the first occurrence wins).
WALLS = [
    ["America/New_York", 2026, 3, 8, 2, 30, 1772955000],
    ["America/New_York", 2026, 11, 1, 1, 30, 1793511000],
    ["America/New_York", 2026, 7, 4, 12, 0, 1783180800],
    ["Europe/Berlin", 2026, 3, 29, 2, 30, 1774747800],
    ["Europe/Berlin", 2026, 10, 25, 2, 30, 1792888200],
    ["Europe/Berlin", 2026, 1, 10, 9, 0, 1768032000],
    ["Australia/Sydney", 2026, 10, 4, 2, 30, 1791045000],
    ["Australia/Sydney", 2026, 4, 5, 2, 30, 1775316600],
    ["Australia/Sydney", 2026, 12, 25, 18, 0, 1798182000],
    ["Australia/Lord_Howe", 2026, 4, 5, 1, 45, 1775313900],
    ["Australia/Lord_Howe", 2026, 10, 4, 2, 15, 1791042300],
    ["America/Santiago", 2026, 9, 6, 0, 30, 1788669000],
    ["Europe/Berlin", 2100, 3, 28, 2, 30, 4109880600],
    ["America/New_York", 2100, 11, 7, 1, 30, 4129248600],
]

test.case(
    "offset and abbreviation match zoneinfo at 254 instants",
    fn() {
        mut wrong = []
        for row in OFFSETS {
            z = zi.in_zone(row[1] * 1000, row[0])
            unless z.offset == row[2] * 1000 and z.abbreviation == row[3] {
                wrong = push(
                    wrong,
                    "{row[0]} @ {row[1]}: got {z.offset / 1000} {z.abbreviation}, want {row[2]} {row[3]}",
                )
            }
        }
        test.eq(wrong, [])
    },
)

test.case("a wall time in a zone becomes the same instant zoneinfo gives", fn() {
    mut wrong = []
    for w in WALLS {
        got = zi.from_components(w[0], w[1], w[2], w[3], w[4], w[5])
        unless got == w[6] * 1000 { wrong = push(wrong, "{w}: got {got / 1000}") }
    }
    test.eq(wrong, [])
})

test.case("in_zone gives the local wall time across both Berlin changes", fn() {
    # 2026-03-29 01:00 UTC is 03:00 CEST; an hour before it is 01:00 CET.
    spring = utc(2026, 3, 29, 1)
    test.eq(
        [
            zi.in_zone(spring, "Europe/Berlin").hour,
            zi.in_zone(spring, "Europe/Berlin").abbreviation,
        ],
        [3, "CEST"],
    )
    before = zi.in_zone(spring - 1 * HOUR, "Europe/Berlin")
    test.eq([before.hour, before.abbreviation, before.dst], [1, "CET", false])
    # 2026-10-25 01:00 UTC is 02:00 CET, after 02:59:59 CEST.
    autumn = zi.in_zone(utc(2026, 10, 25, 1), "Europe/Berlin")
    test.eq([autumn.hour, autumn.offset, autumn.dst], [2, 1 * HOUR, false])
    z = zi.in_zone(utc(2026, 7, 1, 12), "Europe/Berlin")
    test.eq([z.year, z.month, z.day, z.hour, z.zone], [2026, 7, 1, 14, "Europe/Berlin"])
})

test.case("an alias reads as the zone it names", fn() {
    t = utc(2026, 1, 15, 12)
    test.eq(zi.in_zone(t, "US/Eastern").offset, zi.in_zone(t, "America/New_York").offset)
    test.eq(zi.in_zone(t, "US/Eastern").zone, "US/Eastern")
})

test.case("an unknown zone is an error naming it", fn() {
    e = try {
        zi.in_zone(0, "Europe/Berlinn")
        null
    } catch (err) { err }
    test.eq([e.kind, e.reason, e.zone], ["zoneinfo", "unknown_zone", "Europe/Berlinn"])
    test.ok(contains(e.message, "Europe/Berlinn"), e.message)
})

test.case("offset is the zone's offset from UTC at an instant", fn() {
    test.eq(zi.offset(utc(2026, 7, 1), "Asia/Kolkata"), 5 * HOUR + 30 * 60000)
    test.eq(zi.offset(utc(2026, 7, 1), "UTC"), 0)
})

# --- arithmetic on the wall clock --------------------------------------------------

test.case("adding a day across spring-forward keeps the wall time", fn() {
    # Berlin's 2026-03-29 is 23 hours long.
    t = zi.from_components("Europe/Berlin", 2026, 3, 28, 12)
    next = zi.add_days(t, 1, "Europe/Berlin")
    test.eq(zi.in_zone(next, "Europe/Berlin").hour, 12)
    test.eq(next - t, 23 * HOUR)
})

test.case("adding a day across fall-back keeps the wall time", fn() {
    # New York's 2026-11-01 is 25 hours long.
    t = zi.from_components("America/New_York", 2026, 10, 31, 9)
    next = zi.add_days(t, 1, "America/New_York")
    test.eq(zi.in_zone(next, "America/New_York").hour, 9)
    test.eq(next - t, 25 * HOUR)
})

test.case("adding a day in the southern hemisphere keeps the wall time", fn() {
    # Sydney springs forward on 2026-10-04.
    t = zi.from_components("Australia/Sydney", 2026, 10, 3, 8)
    next = zi.add_days(t, 1, "Australia/Sydney")
    test.eq([zi.in_zone(next, "Australia/Sydney").hour, next - t], [8, 23 * HOUR])
})

test.case("in UTC a day is always 24 hours", fn() {
    t = utc(2026, 3, 28, 12)
    test.eq(zi.add_days(t, 1, "UTC") - t, 24 * HOUR)
})

test.case("add_months keeps the wall time in a zone", fn() {
    t = zi.from_components("America/New_York", 2026, 1, 31, 17)
    got = zi.in_zone(zi.add_months(t, 2, "America/New_York"), "America/New_York")
    test.eq([got.month, got.day, got.hour], [3, 31, 17])
})

test.case("start_of_day is local midnight, or the first moment after it", fn() {
    t = zi.from_components("Australia/Sydney", 2026, 7, 1, 15)
    test.eq(
        zi.start_of_day(t, "Australia/Sydney"),
        zi.from_components("Australia/Sydney", 2026, 7, 1),
    )
    # Santiago skips midnight on 2026-09-06: the day starts at 01:00.
    s = zi.start_of_day(zi.from_components("America/Santiago", 2026, 9, 6, 12), "America/Santiago")
    test.eq(zi.in_zone(s, "America/Santiago").hour, 1)
})

# --- formatting and parsing ----------------------------------------------------

test.case("format writes the wall time, with %Z and %z for the zone", fn() {
    t = utc(2026, 7, 1, 12)
    test.eq(zi.format(t, "%Y-%m-%d %H:%M %Z %z", "Europe/Berlin"), "2026-07-01 14:00 CEST +0200")
    test.eq(zi.format(t, "%H:%M %z", "America/St_Johns"), "09:30 -0230")
    test.eq(zi.format(t, "%H:%M %%z", "Europe/Berlin"), "14:00 %z")
    test.eq(zi.format(t, "%H:%M %Z", "UTC"), "12:00 UTC")
})

test.case("to_iso writes the local time with its offset", fn() {
    t = utc(2026, 7, 1, 12)
    test.eq(zi.to_iso(t, "Europe/Berlin"), "2026-07-01T14:00:00.000+02:00")
    test.eq(zi.to_iso(t, "America/New_York"), "2026-07-01T08:00:00.000-04:00")
    test.eq(zi.to_iso(t, "UTC"), "2026-07-01T12:00:00.000+00:00")
    test.eq(time.parse(zi.to_iso(t, "Asia/Kolkata")), t)
})

test.case("parse_format reads a wall time in a zone", fn() {
    got = zi.parse_format("2026-07-01 14:00", "%Y-%m-%d %H:%M", "Europe/Berlin")
    test.eq(got, utc(2026, 7, 1, 12))
})

test.case("zones lists every name, and version names the release", fn() {
    names = zi.zones()
    test.ok(
        contains(names, "Europe/Berlin") and
            contains(names, "US/Eastern") and
            contains(names, "UTC"),
        "missing names",
    )
    test.eq(names, sort(names))
    test.eq(zi.version(), "2026e")
})

# --- fixes ---------------------------------------------------------------------

# The kind and reason a call throws, or null when it returns.
fn thrown(f) {
    try {
        f()
        null
    } catch (e) { [get(e, "kind"), get(e, "reason")] }
}

test.case("parse_format with %z reads the offset in the text, not the zone", fn() {
    fmt = "%d/%m/%Y %H:%M %z"
    test.eq(
        zi.parse_format("29/07/2026 17:00 +0200", fmt, "America/New_York"),
        utc(2026, 7, 29, 15),
    )
    test.eq(zi.parse_format("29/07/2026 17:00 -0500", fmt, "Europe/Berlin"), utc(2026, 7, 29, 22))
    got = zi.parse_format("2026-07-29T17:30 +05:30", "%Y-%m-%dT%H:%M %:z", "UTC")
    test.eq(got, utc(2026, 7, 29, 12))
    # Offset first, then a date full of dashes.
    test.eq(
        zi.parse_format("-0300 2026-07-29 09:00", "%z %Y-%m-%d %H:%M", "UTC"),
        utc(2026, 7, 29, 12),
    )
})

test.case("parse_format treats %%z as literal text, not an offset", fn() {
    got = zi.parse_format("29/07/2026 17:00 %z", "%d/%m/%Y %H:%M %%z", "America/New_York")
    test.eq(got, utc(2026, 7, 29, 21))
})

test.case("parse_format refuses text that does not match", fn() {
    test.eq(
        thrown(fn() zi.parse_format("29/07/2026", "%d/%m/%Y %H:%M", "UTC")),
        ["zoneinfo", "no_match"],
    )
    test.eq(
        thrown(fn() zi.parse_format("29/07/2026 17:00", "%d/%m/%Y %H:%M %z", "UTC")),
        ["zoneinfo", "no_match"],
    )
    test.eq(thrown(fn() zi.parse_format("x", "x%", "UTC")), ["bug", "bad_format"])
})

test.case("format refuses a bad pattern at its own boundary", fn() {
    test.eq(thrown(fn() zi.format(0, "x%", "UTC")), ["bug", "bad_format"])
    test.eq(thrown(fn() zi.format(0, 5, "UTC")), ["bug", "bad_argument"])
})

test.case("an offset with seconds is written in full", fn() {
    # Amsterdam kept local mean time, +00:19:32, until 1937.
    t = utc(1900, 1, 1)
    test.eq(zi.to_iso(t, "Europe/Amsterdam"), "1900-01-01T00:19:32.000+00:19:32")
    test.eq(zi.format(t, "%z", "Europe/Amsterdam"), "+001932")
})

test.case("from_components refuses an impossible wall time", fn() {
    test.eq(thrown(fn() zi.from_components("UTC", 2026, 13, 1)), ["zoneinfo", "out_of_range"])
    test.eq(thrown(fn() zi.from_components("UTC", 2026, 2, 29)), ["zoneinfo", "out_of_range"])
    test.eq(thrown(fn() zi.from_components("UTC", 2026, 4, 31)), ["zoneinfo", "out_of_range"])
    test.eq(thrown(fn() zi.from_components("UTC", 2026, 1, 1, 24)), ["zoneinfo", "out_of_range"])
    test.eq(thrown(fn() zi.from_components("UTC", 2026, 1, 1, 0, 60)), ["zoneinfo", "out_of_range"])
    test.eq(
        thrown(fn() zi.from_components("UTC", 2026, 1, 1, 0, 0, -1)),
        ["zoneinfo", "out_of_range"],
    )
    test.eq(
        thrown(fn() zi.from_components("UTC", 2026, 1, 1, 0, 0, 0, 1000)),
        ["zoneinfo", "out_of_range"],
    )
    test.eq(thrown(fn() zi.from_components("UTC", 2026, "1", 1)), ["bug", "bad_argument"])
    test.eq(thrown(fn() zi.from_components("UTC", 2024, 2, 29)), null)
})

test.case("an unknown zone is a zoneinfo error; a non-string zone is a bug", fn() {
    test.eq(thrown(fn() zi.offset(0, "Nope/Zone")), ["zoneinfo", "unknown_zone"])
    test.eq(thrown(fn() zi.in_zone(0, 5)), ["bug", "bad_argument"])
    test.eq(thrown(fn() zi.in_zone("a", "UTC")), ["bug", "bad_argument"])
    test.eq(thrown(fn() zi.add_days(0, 1.5, "UTC")), ["bug", "bad_argument"])
})

test.case("add_years keeps the wall time, and 29 February becomes the 28th", fn() {
    t = zi.from_components("Europe/Berlin", 2024, 2, 29, 9)
    got = zi.in_zone(zi.add_years(t, 1, "Europe/Berlin"), "Europe/Berlin")
    test.eq([got.year, got.month, got.day, got.hour], [2025, 2, 28, 9])
    back = zi.in_zone(zi.add_years(t, -4, "Europe/Berlin"), "Europe/Berlin")
    test.eq([back.year, back.month, back.day], [2020, 2, 29])
})
