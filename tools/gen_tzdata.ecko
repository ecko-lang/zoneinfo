# Generate tzdata.ecko from a compiled IANA time zone database.
#
#   ecko tools/gen_tzdata.ecko /usr/share/zoneinfo tzdata.ecko
#
# Reads `tzdata.zi` in that directory for the release version, the zone names
# and the aliases (links), then each zone's TZif file (RFC 8536) for its
# transitions. Not shipped with the package: the release archive takes only the
# `.ecko` files at the top level.
#
# Every program that imports zoneinfo loads this data, used or not, so its
# shape is chosen for load time. Each zone is one line of a single multi-line
# raw string, "<name>=<packed>", decoded only when the zone is first used. As
# one string it loads in about 6 ms; as a map of 447 strings it took 13 ms, and
# as number lists 60 ms and four times the memory. A line per zone still keeps
# a tzdata refresh reviewable as a line diff.
#
#   packed = "<types>|<transitions>|<rule>"
#
#   types        off,dst,abbr;off,dst,abbr;...   offset in seconds east of UTC
#   transitions  base-36 seconds, the first absolute (may start with "-") and
#                each later one a delta from the one before, then one base-36
#                digit naming the type in effect from then on; comma-separated
#   rule         the POSIX TZ string for times after the last transition
#
# Before the first transition the first type applies (RFC 8536 3.2).

import std.fs
import std.os

DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz"

fn base36(n) {
    if n < 0 { return "-" + base36(0 - n) }
    if n < 36 { return DIGITS[n..n + 1] }
    base36(n // 36) + DIGITS[n % 36..n % 36 + 1]
}

fn u32(b, off) = b[off] shl 24 bor b[off + 1] shl 16 bor b[off + 2] shl 8 bor b[off + 3]

fn i32(b, off) {
    n = u32(b, off)
    if n >= 2147483648 { n - 4294967296 } else { n }
}

# A signed 64-bit big-endian integer, built from its two halves so nothing
# overflows on the way.
fn i64(b, off) = i32(b, off) * 4294967296 + u32(b, off + 4)

# The six counts in a TZif header starting at `off`.
fn counts(b, off) {
    {
        isut: u32(b, off + 20),
        isstd: u32(b, off + 24),
        leap: u32(b, off + 28),
        time: u32(b, off + 32),
        type: u32(b, off + 36),
        char: u32(b, off + 40),
    }
}

# Parse a TZif file of version 2 or later, reading its 64-bit second section.
fn parse_tzif(b) {
    if b[0..4] != b"TZif" { error({ kind: "parse", message: "not a TZif file" }) }
    if b[4] < 50 { error({ kind: "parse", message: "TZif version 1 has no 64-bit data" }) }
    v1 = counts(b, 0)
    skip = 44 + v1.time * 5 + v1.type * 6 + v1.char + v1.leap * 8 + v1.isstd + v1.isut
    c = counts(b, skip)
    mut off = skip + 44
    mut times = []
    for i in 0..c.time {
        times = push(times, i64(b, off + i * 8))
    }
    off = off + c.time * 8
    idx = b[off..off + c.time]
    off = off + c.time
    mut raw_types = []
    for i in 0..c.type {
        p = off + i * 6
        raw_types = push(raw_types, { off: i32(b, p), dst: b[p + 4], abbr_at: b[p + 5] })
    }
    off = off + c.type * 6
    chars = b[off..off + c.char]
    off = off + c.char + c.leap * 12 + c.isstd + c.isut
    rule = string(b[off..len(b)]) |> trim()
    types = raw_types |> map(fn(t) {
        rest = chars[t.abbr_at..len(chars)]
        end = index_of(rest, b"\x00")
        { off: t.off, dst: t.dst, abbr: string(rest[0..end]) }
    })
    { times: times, idx: idx, types: types, rule: rule }
}

fn pack(z) {
    types = z.types
        |> map(fn(t) "{t.off},{t.dst},{t.abbr}")
        |> join(";")
    mut parts = []
    mut prev = 0
    for i in 0..len(z.times) {
        t = z.times[i]
        delta = if i == 0 { t } else { t - prev }
        if z.idx[i] >= 36 { error({ kind: "parse", message: "more than 36 local time types" }) }
        parts = push(parts, base36(delta) + DIGITS[z.idx[i]..z.idx[i] + 1])
        prev = t
    }
    "{types}|{join(parts, ",")}|{z.rule}"
}

args = os.args()
if len(args) != 2 {
    print("usage: ecko tools/gen_tzdata.ecko <zoneinfo dir> <out.ecko>")
    os.exit(2)
}
root = args[0]
out_path = args[1]

zi = fs.read(fs.join(root, "tzdata.zi"))
lines = split(zi, "\n")
version = trim(replace(lines[0], "# version", ""))
mut zones = []
mut links = []
for line in lines {
    p = split(line, " ")
    if len(p) >= 2 and p[0] == "Z" { zones = push(zones, p[1]) }
    if len(p) >= 3 and p[0] == "L" { links = push(links, [p[2], p[1]]) }
}
zones = sort(zones)
links = sort_with(links, fn(a, b) if a[0] < b[0] { -1 } else if a[0] > b[0] { 1 } else { 0 })

mut out = "# Generated by tools/gen_tzdata.ecko from IANA tzdata {version}. Do not edit.\n"
out = out + "# The packed format is described at the top of that file.\n\n"
out = out + "## The IANA tzdata release these zones come from.\n"
out = out + "export VERSION = \"{version}\"\n\n"
out = out + "## The IANA links, one \"alias=zone\" per line (\"US/Eastern=America/New_York\").\n"
out = out + "export LINKS = r\"\n"
for l in links {
    out = out + "{l[0]}={l[1]}\n"
}
out = out + "\"\n\n"
out = out + "## The zones, one \"name=packed\" per line.\n"
out = out + "export ZONES = r\"\n"
for z in zones {
    out = out + "{z}={pack(parse_tzif(fs.read_bytes(fs.join(root, z))))}\n"
}
out = out + "\"\n"
fs.write(out_path, out)
print("tzdata {version}: {len(zones)} zones, {len(links)} links -> {out_path}")
